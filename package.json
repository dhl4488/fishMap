{
  "name": "tidelog",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:mobile": "cross-env CAPACITOR_BUILD=true nuxt generate",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "mobile:assets": "npx --yes @capacitor/assets@3.0.5 generate --iconBackgroundColor '#0e2d3a' --splashBackgroundColor '#0e2d3a'",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mobile:android": "npm run mobile:sync && cap open android",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/network": "^8.0.1",
    "@google/model-viewer": "^4.4.0",
    "firebase": "^13.0.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "nuxt": "^4.6.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/leaflet": "^1.9.22",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13"
  }
}
