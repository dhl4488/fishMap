+# Builds Tidelog as a static site and publishes it to GitHub Pages on every push to main.
+# Site URL: https://<your-username>.github.io/<repo-name>/ (or your custom domain, if one is set in Settings > Pages)
+#
+# One-time setup (see README "Hosting on GitHub Pages"):
+#   1. Settings > Pages > Build and deployment > Source: "GitHub Actions"
+#   2. Settings > Secrets and variables > Actions > Variables: add the NUXT_PUBLIC_FIREBASE_* values below
+#   3. Firebase console > Authentication > Settings > Authorized domains: add <your-username>.github.io
+name: Deploy to GitHub Pages
+
+on:
+  push:
+    branches: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  pages: write
+  id-token: write
+
+concurrency:
+  group: pages
+  cancel-in-progress: true
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+
+      - run: npm ci
+
+      # Tells us whether the site is served at a sub-path (https://<user>.github.io/<repo>/) or a custom domain (/).
+      - id: pages
+        uses: actions/configure-pages@v5
+
+      - name: Build static site
+        run: npm run generate
+        env:
+          PAGES_BUILD: 'true'
+          NUXT_APP_BASE_URL: ${{ steps.pages.outputs.base_path }}/
+          # Firebase web config is public by design (security comes from firestore.rules / storage.rules),
+          # so these live in repository Variables rather than Secrets.
+          NUXT_PUBLIC_FIREBASE_API_KEY: ${{ vars.NUXT_PUBLIC_FIREBASE_API_KEY }}
+          NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN: ${{ vars.NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN }}
+          NUXT_PUBLIC_FIREBASE_PROJECT_ID: ${{ vars.NUXT_PUBLIC_FIREBASE_PROJECT_ID }}
+          NUXT_PUBLIC_FIREBASE_APP_ID: ${{ vars.NUXT_PUBLIC_FIREBASE_APP_ID }}
+          NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET: ${{ vars.NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET }}
+          NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID: ${{ vars.NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID }}
+          NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID: ${{ vars.NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID }}
+
+      # GitHub Pages runs Jekyll by default, which drops folders starting with "_" (Nuxt's /_nuxt/ bundle).
+      - run: touch .output/public/.nojekyll
+
+      - uses: actions/upload-pages-artifact@v3
+        with:
+          path: .output/public
+
+  deploy:
+    needs: build
+    runs-on: ubuntu-latest
+    environment:
+      name: github-pages
+      url: ${{ steps.deployment.outputs.page_url }}
+    steps:
+      - id: deployment
+        uses: actions/deploy-pages@v4
